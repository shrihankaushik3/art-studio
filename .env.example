# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Provide a MongoDB connection string. If local MongoDB is not running, the application can also use an embedded in-memory MongoDB for local testing.
MONGODB_URI=mongodb://127.0.0.1:27017/artstudio

# Authentication Secret
JWT_SECRET=super_secret_art_studio_jwt_token_key_change_me_in_production

# Seed Configuration (Overrides if seed.json is not present)
# Note: In production or clean machines, studio credentials can be loaded from environment variables
STUDIO_EMAIL=studio@artstudio.in
STUDIO_PASSWORD=replace_with_your_own_password
