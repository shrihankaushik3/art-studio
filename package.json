{
  "name": "art-studio-assignment",
  "version": "1.0.0",
  "description": "Full-stack Art Studio Website with React, Node.js, Express, and MongoDB",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "seed": "npm run seed --workspace=server",
    "test": "npm run test --workspace=server",
    "build": "npm run build --workspace=client",
    "start": "npm run start --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
